<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/cc_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolbarButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btn_forward"
                style="@style/ToolbarButton"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/btn_reload"
                style="@style/ToolbarButton"
                android:contentDescription="@string/reload"
                android:src="@drawable/ic_reload" />

            <ImageButton
                android:id="@+id/btn_home"
                style="@style/ToolbarButton"
                android:contentDescription="@string/home"
                android:src="@drawable/ic_home" />

            <EditText
                android:id="@+id/url_field"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_url"
                android:hint="@string/url_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/cc_text"
                android:textColorHint="@color/cc_muted"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/shield_chip"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:contentDescription="@string/protection"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield" />

                <TextView
                    android:id="@+id/counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="0"
                    android:textColor="@color/cc_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/ToolbarButton"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressBackgroundTint="@color/cc_surface"
            android:progressTint="@color/cc_accent"
            android:visibility="invisible" />

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <com.chromiumcore.tv.PointerOverlayView
        android:id="@+id/pointer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />
</FrameLayout>
