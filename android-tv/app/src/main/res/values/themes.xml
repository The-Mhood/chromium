<resources>
    <style name="Theme.ChromiumCore" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cc_bg</item>
        <item name="android:colorAccent">@color/cc_accent</item>
        <item name="android:colorPrimary">@color/cc_surface</item>
        <item name="android:statusBarColor">@color/cc_bg</item>
        <item name="android:navigationBarColor">@color/cc_bg</item>
    </style>

    <style name="ToolbarButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
